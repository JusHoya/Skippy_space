# Skippy_space — environment template
# Copy this file to `.env` (gitignored) and fill in real values.
# Tauri dev/build, the Node sidecar, OTel, and the infra/ docker stacks all
# read these. Keep this file the SINGLE source of truth — do not duplicate a
# variable with two different values; the last definition silently wins.

# ---- Required for the agent-runtime sidecar ----
# Your Anthropic API key. Used by Skippy + every Board agent.
ANTHROPIC_API_KEY=

# ---- Optional model overrides (per PRD §3.3) ----
# Skippy is Opus by default — cost-disciplined orchestrator.
SKIPPY_MODEL=claude-opus-4-7
# Future Board defaults (used in Phase 1; ignored in Phase 0).
BOARD_DEFAULT_MODEL_SONNET=claude-sonnet-4-6
BOARD_DEFAULT_MODEL_HAIKU=claude-haiku-4-5-20251001

# ---- Logging ----
# Pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Letta (Phase 1+) ----
# Self-hosted Letta server URL. Skippy's hot memory layer.
LETTA_BASE_URL=http://localhost:8283

# =====================================================================
# Telemetry: agent-runtime → OTel collector → Langfuse (PRD §9.2, §9.3)
# =====================================================================
#
# Span path:
#   agent-runtime (Node)  --OTLP/HTTP-->  local collector (:4319)
#   collector             --OTLP/HTTP-->  langfuse-server:3000/api/public/otel
#
# The sidecar always exports to the LOCAL COLLECTOR, never straight to
# Langfuse, so the collector can fan out (Langfuse + debug stdout).
#
# Phase 0: leave this unreachable — the sidecar soft-fails and continues.
# Phase 1: the docker collector listens on :4319 (see infra/otel-collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319/v1/traces

# ---- Langfuse project API keys ----
# These provision the project at first boot (LANGFUSE_INIT_PROJECT_* in
# infra/langfuse/docker-compose.yml) AND authenticate the SDK/UI. Pick any
# stable strings in the pk-lf-/sk-lf- shape, e.g.:
#   pk-lf-0000000000000000000000000000000000000000
#   sk-lf-0000000000000000000000000000000000000000
# Generate random ones with:
#   pwsh:  "pk-lf-" + [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N").Substring(0,8)
#   bash:  printf 'pk-lf-%s\n' "$(openssl rand -hex 24)"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- Collector → Langfuse OTLP auth (REQUIRED for spans to land) ----
# Langfuse's OTLP endpoint needs HTTP Basic auth: base64("<public>:<secret>").
# The collector injects this verbatim as `Authorization: Basic <value>`.
# It MUST equal base64(LANGFUSE_PUBLIC_KEY ":" LANGFUSE_SECRET_KEY) above, or
# every span is rejected 401. Compute it after setting the keys:
#   pwsh:  [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("$($env:LANGFUSE_PUBLIC_KEY):$($env:LANGFUSE_SECRET_KEY)"))
#   bash:  echo -n "$LANGFUSE_PUBLIC_KEY:$LANGFUSE_SECRET_KEY" | base64 -w0
LANGFUSE_OTEL_AUTH_BASIC=

# =====================================================================
# infra/langfuse docker stack — REQUIRED secrets (no safe defaults)
# =====================================================================
# The compose file uses `${VAR:?...}` for these, so `docker compose up` will
# FAIL LOUDLY if any are blank rather than booting with a known password.
# All services bind to 127.0.0.1 only — nothing is reachable off-host.
#
# Generate the high-entropy values with (bash):
#   LANGFUSE_SALT / *_NEXTAUTH_SECRET / *_PASSWORD : openssl rand -base64 32
#   LANGFUSE_ENCRYPTION_KEY                        : openssl rand -hex 32
# or (pwsh):
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))      # 32-byte secrets
#   -join ((1..64 | % { '{0:x}' -f (Get-Random -Max 16) }))             # 64 hex chars

# Postgres (relational store)
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=langfuse

# ClickHouse (v3 analytical store)
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=

# Redis (v3 ingestion queue)
LANGFUSE_REDIS_PASSWORD=

# MinIO / S3-compatible blob store (v3 event + media uploads)
LANGFUSE_S3_ACCESS_KEY_ID=
LANGFUSE_S3_SECRET_ACCESS_KEY=
LANGFUSE_S3_BUCKET=langfuse

# App secrets (32+ random chars each; ENCRYPTION_KEY is 64 hex chars)
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=

# First-boot bootstrap user (created once on an empty DB)
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# Optional first-boot org/project labels (cosmetic; compose has safe defaults).
# Leave blank to accept the defaults baked into infra/langfuse/docker-compose.yml.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_USER_NAME=

# ---- Tauri development ----
# Set to 1 to disable sidecar auto-restart (handy when iterating the runtime).
SKIPPY_NO_RESTART=
