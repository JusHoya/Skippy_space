{
  "name": "@skippy/agent-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "skippy-runtime": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "lint": "eslint src --max-warnings=-1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162",
    "@anthropic-ai/sdk": "^0.30",
    "@modelcontextprotocol/sdk": "^1.2",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55",
    "@opentelemetry/resources": "^1.27",
    "@opentelemetry/sdk-node": "^0.55",
    "@opentelemetry/semantic-conventions": "^1.27",
    "@skippy/memory": "workspace:^",
    "@skippy/shared": "workspace:*",
    "js-yaml": "4.1.1",
    "node-cron": "^4.2.1",
    "pino": "^9",
    "ulid": "^2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5.7"
  }
}
