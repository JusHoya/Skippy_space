# Obsidian local config — keep settings, ignore workspace state
.obsidian/workspace*.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Smart Connections embeddings — regenerable, large
.smart-env/

# Skippy_space-specific
.skippy/
*.tmp
*.lock
# Ingest freeze files (`.<hex>.<name>.ingest-tmp`, recovered at watcher start)
# and the contained atomic writer's temp files: never commit either (M0 final #7).
*.ingest-tmp
.skippy-*.tmp
